  },
  "dependencies": {
    "@paypal/paypal-js": "^8.3.0",
    "@paypal/paypal-server-sdk": "^1.1.0",
    "@paypal/react-paypal-js": "^8.9.1",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "crypto-js": "^4.2.0",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.12.0",
    "styled-components": "^6.1.6"
