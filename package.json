    "@types/styled-components": "^5.1.34",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.2",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "typescript": "^5.7.2"
